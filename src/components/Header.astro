---
import { nav, site } from "../data/site";

interface Props {
  active?: string;
}
const { active } = Astro.props;
---

<header class="sticky top-0 z-20 border-b border-line bg-[rgba(245,243,238,0.82)] backdrop-blur-md">
  <div class="container-page flex flex-wrap items-center justify-between gap-x-6 gap-y-3 py-4">
    <a
      href="/"
      class="flex items-center gap-2.5 text-base font-medium tracking-[-0.01em]"
    >
      <span class="size-2.5 rounded-full bg-accent" aria-hidden="true"></span>
      {site.name}
    </a>
    <nav
      aria-label="Primary"
      class="-mx-5 flex gap-x-7 overflow-x-auto px-5 text-sm whitespace-nowrap [scrollbar-width:none] max-sm:w-[calc(100%+40px)] sm:mx-0 sm:flex-wrap sm:overflow-visible sm:px-0"
    >
      {nav.map(item => (
        <a
          href={item.href}
          class:list={[item.label === active && "text-accent"]}
          aria-current={item.label === active ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>
