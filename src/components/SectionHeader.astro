---
interface Props {
  id: string;
  label: string;
  title: string;
  dark?: boolean;
}
const { id, label, title, dark = false } = Astro.props;
---

<div class="flex flex-col gap-4">
  <p class:list={["label-mono m-0", dark && "text-muted-dark!"]}>{label}</p>
  <h2 id={id} class="h-section">
    {title}
  </h2>
</div>
