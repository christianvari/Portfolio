---
import patents from "../data/patents.json";
import SectionHeader from "./SectionHeader.astro";
---

<section
  id="patents"
  class="border-t border-line"
  aria-labelledby="patents-title"
>
  <div class="container-page section-y">
    <div data-reveal class="mb-12">
      <SectionHeader
        id="patents-title"
        label="03 — Patents"
        title={patents.length === 1 ? "Patent" : "Patents"}
      />
    </div>
    <ul class="m-0 flex list-none flex-col border-b border-line p-0">
      {patents.map(p => (
        <li data-reveal>
          <a
            href={p.url}
            target="_blank"
            rel="noopener"
            class="-mx-4 flex flex-wrap items-baseline gap-x-8 gap-y-2.5 border-t border-line px-4 py-[30px] text-ink transition-colors duration-250 hover:bg-surface hover:text-ink"
          >
            <p class="m-0 flex-[0_0_180px] font-mono text-[13px] text-muted">
              {p.number}
            </p>
            <div class="flex flex-[1_1_360px] flex-col gap-1.5">
              <h3 class="m-0 text-[26px] font-medium tracking-[-0.02em]">
                {p.title} ↗
              </h3>
              {p.originalTitle && (
                <p class="m-0 text-sm text-muted italic" lang={p.originalLang}>
                  {p.originalTitle}
                </p>
              )}
              {p.description && (
                <p class="m-0 text-base text-ink-2">{p.description}</p>
              )}
            </div>
            <p class="m-0 flex-[0_0_auto] text-sm text-muted">
              {p.status} · {p.granted} (filed {p.filed})
            </p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
