---
import { heroSnippets, typedWords } from "../data/heroCode";
import { site } from "../data/site";
import PillButton from "./PillButton.astro";

// Both code layers share this exact layout so the lens mask lines up with the faint copy.
// Snippets repeat so the grid always fills the hero, however wide or tall it is.
const layer =
  "absolute -inset-5 grid content-start gap-x-16 gap-y-7 overflow-hidden p-10 font-mono text-[15px] leading-[1.75] select-none [grid-template-columns:repeat(auto-fill,minmax(min(100%,600px),1fr))]";
const blocks = [...heroSnippets, ...heroSnippets];
---

<section
  id="top"
  class="hero relative min-h-[calc(100svh-60px)] cursor-none overflow-hidden border-b border-line"
  data-lens-host
  aria-labelledby="hero-title"
>
  <!-- Decorative code lives in a <template> so scrapers and agents don't read it as page text;
       src/scripts/hero.ts copies it into both layers. -->
  <template data-hero-code>
    {blocks.map(
      code => <pre class="m-0 overflow-hidden whitespace-pre">{code}</pre>,
    )}
  </template>
  <div
    class:list={[layer, "text-[rgba(27,26,23,0.07)]"]}
    data-code-layer
    aria-hidden="true"
  ></div>
  <div
    class:list={[layer, "lens text-[rgba(27,26,23,0.4)]"]}
    data-code-layer
    data-lens
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute top-0 left-0 -mt-[190px] -ml-[190px] size-[380px] rounded-full border border-[rgba(47,91,211,0.35)] will-change-transform"
    data-lens-ring
    aria-hidden="true"
  ></div>

  <div class="container-page pointer-events-none relative z-[1] box-border! flex min-h-[calc(100svh-60px)] flex-col justify-between gap-12 pt-[clamp(72px,14vh,160px)] pb-16">
    <div class="flex flex-col gap-8">
      <div class="flex flex-col gap-[18px]">
        <p class="label-mono m-0">
          Security Researcher — Founder &amp; CEO, Codezen
        </p>
        <h1
          id="hero-title"
          class="m-0 text-[clamp(68px,13vw,200px)] leading-[0.88] font-medium tracking-[-0.06em]"
        >
          {site.name}
          <span class="text-accent">.</span>
        </h1>
      </div>
      <p class="m-0 max-w-[900px] text-[clamp(28px,3.6vw,54px)] leading-[1.05] font-medium tracking-[-0.035em] text-ink-2">
        Securing
        <span class="block min-h-[1em] text-accent">
          <span data-typer data-words={JSON.stringify(typedWords)}>
            {typedWords[0]}
          </span>
          <span
            class="ml-[0.06em] inline-block h-[0.8em] w-[0.06em] animate-blink bg-accent align-[-0.05em]"
            aria-hidden="true"
          ></span>
        </span>
      </p>
    </div>

    <div class="flex flex-wrap items-end justify-between gap-8">
      <p class="m-0 max-w-[520px] text-[clamp(17px,1.4vw,20px)] leading-normal text-pretty text-ink-2">
        Solana, Cosmos SDK, Polkadot SDK, Ethereum and EVM. Head of Audit
        Operations at Oak Security.
      </p>
      <div class="pointer-events-auto flex flex-wrap gap-3">
        <PillButton href="/audits">See all audits →</PillButton>
        <PillButton href="#contact" variant="secondary">
          Get in touch
        </PillButton>
      </div>
    </div>
  </div>
</section>

<style>
  .lens {
    --mx: 70%;
    --my: 40%;
    -webkit-mask-image: radial-gradient(
      circle 190px at var(--mx) var(--my),
      #000 30%,
      transparent 100%
    );
    mask-image: radial-gradient(
      circle 190px at var(--mx) var(--my),
      #000 30%,
      transparent 100%
    );
  }
  /* Soft background halo so the revealed code recedes behind the hero text. */
  .hero :is(h1, p) {
    text-shadow:
      0 0 12px var(--color-bg),
      0 0 24px var(--color-bg);
  }
  @media (hover: none) {
    .hero {
      cursor: auto;
    }
  }
</style>

<script>
  import "../scripts/hero";
</script>
